{
  "memory_dir": "memory",
  "providers": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "default_model": "openrouter/auto",
      "extra_headers": {
        "HTTP-Referer": "$AI_APP_REFERER",
        "X-Title": "$AI_APP_TITLE"
      }
    },
    "bytez": {
      "base_url": "https://api.bytez.com/models/v2/openai/v1",
      "api_key_env": "BYTEZ_API_KEY",
      "default_model": "Qwen/Qwen3-4B",
      "extra_headers": {
        "provider-key": "$BYTEZ_PROVIDER_KEY"
      }
    },
    "nvidia_nim": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "default_model": "nvidia/llama-3.1-nemotron-70b-instruct",
      "extra_headers": {}
    },
    "local_vllm": {
      "base_url": "http://localhost:8000/v1",
      "api_key_env": "LOCAL_LLM_API_KEY",
      "default_model": "local-model",
      "extra_headers": {}
    }
  },
  "agents": {
    "planner": {
      "role": "planner",
      "provider": "openrouter",
      "model": "openrouter/auto",
      "temperature": 0.2,
      "max_tokens": 900
    },
    "worker": {
      "role": "worker",
      "provider": "bytez",
      "model": "Qwen/Qwen3-4B",
      "temperature": 0.35,
      "max_tokens": 1600
    },
    "reviewer": {
      "role": "reviewer",
      "provider": "nvidia_nim",
      "model": "nvidia/llama-3.1-nemotron-70b-instruct",
      "temperature": 0.15,
      "max_tokens": 900
    },
    "worker_fallback": {
      "role": "worker",
      "provider": "openrouter",
      "model": "openrouter/auto",
      "temperature": 0.35,
      "max_tokens": 1600
    },
    "reviewer_fallback": {
      "role": "reviewer",
      "provider": "openrouter",
      "model": "openrouter/auto",
      "temperature": 0.15,
      "max_tokens": 900
    }
  },
  "routing": {
    "default": ["planner", "worker", "reviewer"],
    "cheap": ["worker"],
    "review": ["reviewer"]
  }
}
