{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/nvidia-nim",
      "destination": "/api/bytez?provider=nvidia_nim"
    },
    {
      "source": "/api/syntage",
      "destination": "/api/gemini?route=syntage"
    },
    {
      "source": "/api/pipeline/import",
      "destination": "/api/documents/process?pipelineImport=1"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico$|favicon\\.svg$|favicon-32x32\\.png$|apple-touch-icon\\.png$|site\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
