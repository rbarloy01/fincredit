    "activos_productivos": {
      "description": "Activos productivos. Incluye cartera neta, bancos/inversiones disponibles no comprometidas y otros activos generadores cuando el tipo de entidad lo soporte.",
      "components": [
        "bancos_inversiones_disponibles_no_comprometidas",
        "cartera_neta",
        "otros_activos_generadores"
      ],
      "review_required": true,
      "review_reason": "La composicion de activos productivos puede variar segun tipo de entidad; confirmar si otros activos generadores aplican antes de aprobar el ratio.",
      "default_formula": "bancos_inversiones_disponibles_no_comprometidas + cartera_neta + otros_activos_generadores"
    },
    "otros_activos_generadores": {
      "description": "Otros activos generadores de ingresos o rendimiento financiero, sujetos a validacion por tipo de entidad.",
