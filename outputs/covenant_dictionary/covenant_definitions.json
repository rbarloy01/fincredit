  "ratios": [
    {
      "name": "Margen Financiero",
      "key": "margen_financiero",
      "formula": "margen_financiero_ajustado / (ingresos_por_intereses + ingresos_por_comisiones)",
      "required_concepts": [
        "margen_financiero_ajustado",
        "ingresos_por_intereses",
        "ingresos_por_comisiones"
      ],
      "format": "percent"
    },
    {
      "name": "Margen Operativo",
      "key": "margen_operativo",
      "formula": "utilidad_operacion_ajustada / (ingresos_por_intereses + ingresos_por_comisiones)",
      "required_concepts": [
        "utilidad_operacion_ajustada",
        "ingresos_por_intereses",
        "ingresos_por_comisiones"
      ],
      "format": "percent"
    },
    {
      "name": "Margen Neto",
      "key": "margen_neto",
      "formula": "utilidad_neta / (ingresos_por_intereses + ingresos_por_comisiones)",
      "required_concepts": [
        "utilidad_neta",
        "ingresos_por_intereses",
        "ingresos_por_comisiones"
      ],
      "format": "percent"
    },
    {
      "name": "Rentabilidad Operativa",
      "key": "rentabilidad_operativa",
      "formula": "(gastos_por_comisiones + gastos_administracion_venta_operacion) / (ingresos_por_intereses + ingresos_por_comisiones)",
      "required_concepts": [
        "gastos_por_comisiones",
        "gastos_administracion_venta_operacion",
        "ingresos_por_intereses",
        "ingresos_por_comisiones"
      ],
      "format": "percent"
    },
    {
      "name": "ROE",
      "key": "roe",
      "formula": "utilidad_neta / total_capital_contable",
      "required_concepts": [
        "utilidad_neta",
        "total_capital_contable"
      ],
      "format": "percent"
    },
    {
      "name": "ROA",
      "key": "roa",
      "formula": "utilidad_neta / total_activo",
      "required_concepts": [
        "utilidad_neta",
        "total_activo"
      ],
      "format": "percent"
    },
    {
      "name": "Cartera Vencida",
      "key": "cartera_vencida_ratio",
      "formula": "cartera_vencida / cartera_administrada",
      "required_concepts": [
        "cartera_vencida",
        "cartera_administrada"
      ],
      "format": "percent"
    },
    {
      "name": "Cartera Vencida Neta",
      "key": "cartera_vencida_neta",
      "formula": "(cartera_vencida - estimacion_preventiva) / cartera_administrada",
      "required_concepts": [
        "cartera_vencida",
        "estimacion_preventiva",
        "cartera_administrada"
      ],
      "format": "percent"
    },
    {
      "name": "Tasa Activa",
      "key": "tasa_activa",
      "formula": "ingresos_por_intereses / cartera_neta",
      "required_concepts": [
        "ingresos_por_intereses",
        "cartera_neta"
      ],
      "format": "percent"
    },
    {
      "name": "Tasa Pasiva",
      "key": "tasa_pasiva",
      "formula": "gastos_por_intereses / (bancos_y_fondos_cp + bancos_y_fondos_lp)",
      "required_concepts": [
        "gastos_por_intereses",
        "bancos_y_fondos_cp",
        "bancos_y_fondos_lp"
      ],
      "format": "percent"
    },
    {
      "name": "Apalancamiento",
      "key": "apalancamiento",
      "formula": "(bancos_y_fondos_cp + bancos_y_fondos_lp) / total_activo",
      "required_concepts": [
        "bancos_y_fondos_cp",
        "bancos_y_fondos_lp",
        "total_activo"
      ],
      "format": "percent"
    },
    {
      "name": "ICAP",
      "key": "icap",
      "formula": "total_capital_contable / total_activo",
      "required_concepts": [
        "total_capital_contable",
        "total_activo"
      ],
      "format": "percent"
    },
    {
      "name": "ICAP Ajustado",
      "key": "icap_ajustado",
      "formula": "total_capital_contable / cartera_neta",
      "required_concepts": [
        "total_capital_contable",
        "cartera_neta"
      ],
      "format": "percent"
    },
    {
      "name": "Cobertura de Deuda",
      "key": "cobertura_de_deuda",
      "formula": "activos_productivos / total_pasivo",
      "required_concepts": [
        "activos_productivos",
        "total_pasivo"
      ],
      "format": "x"
    }
  ]
}
