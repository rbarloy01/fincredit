        "bienes en arrendamiento financiero",
        "factoraje financiero",
        "derechos de cobro",
        "portafolio de inversion",
        "instrumentos financieros"
      ],
      "default_value_if_missing": 0,
      "review_required": true,
      "review_reason": "Solo debe incluirse cuando el documento o la entidad indiquen que el activo genera rendimiento financiero recurrente."
    }
